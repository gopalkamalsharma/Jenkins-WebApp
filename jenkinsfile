pipeline{
    agent {label 'frontend'}
    stages{
        stage('Pre Build Actions'){
            steps{
                sh 'npm install'
            }
        }
        stage('Build'){
            steps{
                sh 'npm run build'
            }
        }
        stage('Post Build Actions'){
            steps{
                sh 'echo "Build Completed Successfully"'
                sh 'cp -r dist/* /var/www/html/'
            }
        }
    }
}